# GitHub OAuth App — Create at https://github.com/settings/applications/new
# For Device Flow, ensure "Enable Device Flow" is checked in the OAuth App settings.
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Optional: redirect URI for fallback OAuth flow
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# Server port (default: 3001)
PORT=3001

# Templates directory (defaults to ../templates relative to server/)
# TEMPLATES_DIR=/path/to/templates

# Node environment
NODE_ENV=development
