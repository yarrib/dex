"""{{ project_name }} — {{ description }}

Entry point. Implements a minimal plan → act → review loop.
"""

import json
import logging
from pathlib import Path

import anthropic
import mlflow

from {{ project_name }}.tools import discover_tools
from {{ project_name }}.tools.planner import plan as plan_tool
from {{ project_name }}.tools.reviewer import review as review_tool

logger = logging.getLogger(__name__)

SYSTEM_PROMPT = (Path(__file__).parent / "prompts" / "system.md").read_text()

_client = anthropic.Anthropic()


def run(input_data: str | None = None) -> str:
    """Run the agent end-to-end.

    Flow:
      1. Plan       — `planner.plan(input)` produces an explicit plan.
      2. Act        — call the main model with tools available.
      3. Review     — `reviewer.review(...)` checks the draft before return.
      4. Return     — emit the reviewed text.

    Args:
        input_data: Caller's request. None for scheduled/event triggers.

    Returns:
        The agent's reviewed response as a string.
    """
    mlflow.set_experiment("{{ project_name }}")

    request = input_data or "(no input — scheduled or event-triggered run)"
    tools = discover_tools()

    with mlflow.start_run():
        mlflow.log_param("tools", list(tools.keys()))
        logger.info("agent_start", extra={"input": request})

        # 1. Plan
        plan_result = plan_tool(request)
        plan_text = plan_result.data if plan_result.success else "(planning failed)"
        mlflow.log_text(plan_text, "plan.md")

        # 2. Act
        response = _client.messages.create(
            model="claude-opus-4-5",
            max_tokens=4096,
            system=SYSTEM_PROMPT,
            messages=[
                {"role": "user", "content": f"PLAN:\n{plan_text}\n\nREQUEST:\n{request}"}
            ],
        )
        draft = response.content[0].text
        mlflow.log_text(draft, "draft.md")

        # 3. Review
        review_result = review_tool(
            request=request,
            plan=plan_text,
            tool_trace="(no tool calls in this starter implementation)",
            draft=draft,
        )
        review_text = review_result.data if review_result.success else "(review failed)"
        mlflow.log_text(review_text, "review.md")

        # 4. Return. In a real agent, parse VERDICT from review_text and gate the return.
        logger.info("agent_complete", extra={"verdict_preview": review_text[:120]})
        return draft


def main() -> None:
    """CLI entry point for local development."""
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    result = run()
    print(json.dumps({"result": result}, indent=2))


if __name__ == "__main__":
    main()
