"""Planner tool — produces an explicit plan for a request."""

from pathlib import Path

import anthropic

from . import ToolResult

_PLANNING_PROMPT = (
    Path(__file__).parent.parent / "prompts" / "planning.md"
).read_text()

_client = anthropic.Anthropic()


def plan(request: str) -> ToolResult:
    """Produce a plan for the given request before any action is taken.

    Returns a ToolResult whose data is the plan text in the format defined by
    `prompts/planning.md`. The caller is expected to execute the plan step by
    step, recording tool calls and results for later review.
    """
    try:
        response = _client.messages.create(
            model="claude-opus-4-5",
            max_tokens=1024,
            system=_PLANNING_PROMPT,
            messages=[{"role": "user", "content": request}],
        )
        return ToolResult(success=True, data=response.content[0].text)
    except Exception as e:
        return ToolResult(success=False, data=None, error=str(e))
