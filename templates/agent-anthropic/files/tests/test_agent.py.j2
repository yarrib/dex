"""Tests for {{ project_name }}."""

from unittest.mock import MagicMock, patch

from {{ project_name }}.tools import discover_tools


def test_tools_discovered():
    """Tools are discoverable from the tools/ directory."""
    tools = discover_tools()
    assert isinstance(tools, dict)


def test_agent_runs():
    """Smoke test — agent runs without error (mocked Anthropic client)."""
    mock_response = MagicMock()
    mock_response.content = [MagicMock(text="test output")]

    with patch("{{ project_name }}.agent._client") as mock_client:
        mock_client.messages.create.return_value = mock_response
        from {{ project_name }}.agent import run
        result = run("test input")

    assert result == "test output"
