"""Model backend for {{ project_name }} — drafts and edits Terraform (HCL).

Backed by {% if llm_provider == "anthropic" %}the Anthropic SDK (Claude){% else %}a Databricks Foundation Model serving endpoint (Claude on
Databricks){% endif %}. The model only ever returns HCL text; it never applies anything —
applying is the pull-request reviewer's job.
"""

from __future__ import annotations

import logging
from pathlib import Path

from {{ project_name }}.config import settings
from {{ project_name }}.tools import ToolResult

logger = logging.getLogger(__name__)

_PROMPTS = Path(__file__).parent / "prompts"
SYSTEM_PROMPT = (_PROMPTS / "system.md").read_text()
GENERATE_PROMPT = (_PROMPTS / "generate.md").read_text()

# Use the most capable Claude model for HCL generation.
_MODEL = "claude-opus-4-8"
_MAX_TOKENS = 8000


def _build_user_prompt(change_request: str, existing_tf: str) -> str:
    return GENERATE_PROMPT.format(
        change_request=change_request,
        existing_tf=existing_tf or "(no existing Terraform found)",
        cloud=settings.cloud,
        tf_backend=settings.tf_backend,
    )


{% if llm_provider == "anthropic" %}
def draft_terraform(change_request: str, existing_tf: str = "") -> ToolResult:
    """Draft or edit Terraform for ``change_request`` via the Anthropic SDK.

    Returns a :class:`ToolResult` whose ``data`` is the model's HCL output.
    """
    try:
        import anthropic
    except ImportError:
        return ToolResult.fail("anthropic package not installed")

    client = anthropic.Anthropic()
    try:
        # Stream + adaptive thinking: HCL generation can be long; streaming
        # avoids request timeouts and adaptive thinking lets Claude reason about
        # provider schemas before emitting config.
        with client.messages.stream(
            model=_MODEL,
            max_tokens=_MAX_TOKENS,
            thinking={"type": "adaptive"},
            system=SYSTEM_PROMPT,
            messages=[{"role": "user", "content": _build_user_prompt(change_request, existing_tf)}],
        ) as stream:
            message = stream.get_final_message()
    except Exception as exc:  # noqa: BLE001 - surfaced as a ToolResult.
        return ToolResult.fail(f"model call failed: {exc}")

    text = "".join(b.text for b in message.content if b.type == "text")
    return ToolResult.ok(text.strip())
{% else %}
def draft_terraform(change_request: str, existing_tf: str = "") -> ToolResult:
    """Draft or edit Terraform for ``change_request`` via a Databricks Foundation
    Model serving endpoint.

    ``settings.llm_endpoint`` names the workspace's Claude endpoint (e.g.
    ``databricks-claude-opus-4``). Returns a :class:`ToolResult` whose ``data``
    is the model's HCL output.
    """
    from {{ project_name }}.auth import workspace_client

    try:
        client = workspace_client().serving_endpoints.get_open_ai_client()
        response = client.chat.completions.create(
            model=settings.llm_endpoint,
            max_tokens=_MAX_TOKENS,
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": _build_user_prompt(change_request, existing_tf)},
            ],
        )
    except Exception as exc:  # noqa: BLE001 - surfaced as a ToolResult.
        return ToolResult.fail(f"serving endpoint call failed: {exc}")

    text = response.choices[0].message.content or ""
    return ToolResult.ok(text.strip())
{% endif %}
