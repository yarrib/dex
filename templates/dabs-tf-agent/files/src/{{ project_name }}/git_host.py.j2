"""Git host client for {{ project_name }} — opens branches and pull requests.

This module targets **{{ git_host }}**. It speaks the host's REST API directly
(via ``requests``) so there is no heavyweight SDK dependency and the same shape
works on a job cluster. It only ever *proposes* changes (branch + PR); it never
pushes to ``{{ default_branch }}`` and never merges{% if allow_auto_merge %} (beyond enabling auto-merge){% endif %}.
"""

from __future__ import annotations

import base64
import logging

import requests

from {{ project_name }}.auth import git_token
from {{ project_name }}.config import settings

logger = logging.getLogger(__name__)

_TIMEOUT = 30


class GitHostError(RuntimeError):
    """Raised when the git host API returns an error."""


{% if git_host == "github" %}
def _headers() -> dict[str, str]:
    return {
        "Authorization": f"Bearer {git_token()}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }


def _repo_url() -> str:
    return f"{settings.github_api}/repos/{settings.github_owner}/{settings.github_repo}"


def _default_sha() -> str:
    r = requests.get(
        f"{_repo_url()}/git/ref/heads/{settings.default_branch}",
        headers=_headers(),
        timeout=_TIMEOUT,
    )
    if not r.ok:
        raise GitHostError(f"could not read default branch: {r.status_code} {r.text}")
    return r.json()["object"]["sha"]


def create_branch(branch: str) -> None:
    """Create ``branch`` off the default branch (idempotent)."""
    sha = _default_sha()
    r = requests.post(
        f"{_repo_url()}/git/refs",
        headers=_headers(),
        json={"ref": f"refs/heads/{branch}", "sha": sha},
        timeout=_TIMEOUT,
    )
    if r.status_code == 422:  # already exists
        logger.info("branch %s already exists", branch)
        return
    if not r.ok:
        raise GitHostError(f"create_branch failed: {r.status_code} {r.text}")


def put_file(branch: str, path: str, content: str, message: str) -> None:
    """Create or update ``path`` on ``branch`` with ``content``."""
    get = requests.get(
        f"{_repo_url()}/contents/{path}",
        headers=_headers(),
        params={"ref": branch},
        timeout=_TIMEOUT,
    )
    sha = get.json().get("sha") if get.ok else None
    payload = {
        "message": message,
        "content": base64.b64encode(content.encode()).decode(),
        "branch": branch,
    }
    if sha:
        payload["sha"] = sha
    r = requests.put(
        f"{_repo_url()}/contents/{path}",
        headers=_headers(),
        json=payload,
        timeout=_TIMEOUT,
    )
    if not r.ok:
        raise GitHostError(f"put_file {path} failed: {r.status_code} {r.text}")


def open_pull_request(branch: str, title: str, body: str) -> str:
    """Open a PR from ``branch`` into the default branch; return its URL."""
    r = requests.post(
        f"{_repo_url()}/pulls",
        headers=_headers(),
        json={
            "title": title,
            "head": branch,
            "base": settings.default_branch,
            "body": body,
        },
        timeout=_TIMEOUT,
    )
    if not r.ok:
        raise GitHostError(f"open_pull_request failed: {r.status_code} {r.text}")
    pr = r.json()
{% if allow_auto_merge %}
    _enable_auto_merge(pr["node_id"])
{% endif %}
    return pr["html_url"]

{% if allow_auto_merge %}
def _enable_auto_merge(pr_node_id: str) -> None:
    query = (
        "mutation($id:ID!){enablePullRequestAutoMerge("
        "input:{pullRequestId:$id,mergeMethod:SQUASH}){clientMutationId}}"
    )
    r = requests.post(
        "https://api.github.com/graphql",
        headers=_headers(),
        json={"query": query, "variables": {"id": pr_node_id}},
        timeout=_TIMEOUT,
    )
    if not r.ok:
        logger.warning("could not enable auto-merge: %s", r.text)
{% endif %}
{% else %}
_API_VERSION = "7.1"


def _headers() -> dict[str, str]:
    # Azure DevOps PAT auth: basic auth with empty username + token.
    token = base64.b64encode(f":{git_token()}".encode()).decode()
    return {"Authorization": f"Basic {token}", "Content-Type": "application/json"}


def _repo_url() -> str:
    return (
        f"{settings.ado_api}/{settings.ado_org}/{settings.ado_project}"
        f"/_apis/git/repositories/{settings.ado_repo}"
    )


def _default_object_id() -> str:
    r = requests.get(
        f"{_repo_url()}/refs",
        headers=_headers(),
        params={"filter": f"heads/{settings.default_branch}", "api-version": _API_VERSION},
        timeout=_TIMEOUT,
    )
    if not r.ok or not r.json().get("value"):
        raise GitHostError(f"could not read default branch: {r.status_code} {r.text}")
    return r.json()["value"][0]["objectId"]


def create_branch(branch: str) -> None:
    """Branch creation on ADO happens implicitly via the first push."""
    logger.info("branch %s will be created on first push", branch)


def put_file(branch: str, path: str, content: str, message: str) -> None:
    """Create or update ``path`` on ``branch`` via a single-commit push."""
    base = _default_object_id()
    payload = {
        "refUpdates": [{"name": f"refs/heads/{branch}", "oldObjectId": base}],
        "commits": [
            {
                "comment": message,
                "changes": [
                    {
                        "changeType": "edit",
                        "item": {"path": f"/{path}"},
                        "newContent": {"content": content, "contentType": "rawtext"},
                    }
                ],
            }
        ],
    }
    r = requests.post(
        f"{_repo_url()}/pushes",
        headers=_headers(),
        params={"api-version": _API_VERSION},
        json=payload,
        timeout=_TIMEOUT,
    )
    if r.status_code == 400 and "TF401028" in r.text:  # path is new -> add
        payload["commits"][0]["changes"][0]["changeType"] = "add"
        r = requests.post(
            f"{_repo_url()}/pushes",
            headers=_headers(),
            params={"api-version": _API_VERSION},
            json=payload,
            timeout=_TIMEOUT,
        )
    if not r.ok:
        raise GitHostError(f"put_file {path} failed: {r.status_code} {r.text}")


def open_pull_request(branch: str, title: str, body: str) -> str:
    """Open a PR from ``branch`` into the default branch; return its URL."""
    payload = {
        "sourceRefName": f"refs/heads/{branch}",
        "targetRefName": f"refs/heads/{settings.default_branch}",
        "title": title,
        "description": body,
    }
    r = requests.post(
        f"{_repo_url()}/pullrequests",
        headers=_headers(),
        params={"api-version": _API_VERSION},
        json=payload,
        timeout=_TIMEOUT,
    )
    if not r.ok:
        raise GitHostError(f"open_pull_request failed: {r.status_code} {r.text}")
    pr = r.json()
    return (
        f"{settings.ado_api}/{settings.ado_org}/{settings.ado_project}"
        f"/_git/{settings.ado_repo}/pullrequest/{pr['pullRequestId']}"
    )
{% endif %}
