bundle:
  name: {{ project_name }}

artifacts:
  {{ project_name }}_whl:
    type: whl
    build: uv build

workspace:
  host: ${var.workspace_url}

variables:
  workspace_url:
    description: Databricks workspace URL
  catalog:
    description: Unity Catalog catalog name
    default: main
  schema:
    description: Unity Catalog schema name
    default: default
  git_secret_scope:
    description: Secret scope holding the git token (service-principal fallback)
    default: {{ secret_scope }}
{% if headless_auth == "service_principal" %}
  service_principal_id:
    description: Service principal application ID used for headless runs
    default: ""
{% endif %}

include:
  - resources/*.yml

targets:
  dev:
    mode: development
    default: true
    variables:
      workspace_url: ""
      catalog: dev
      schema: {{ project_name }}_dev

  staging:
    mode: development
    variables:
      workspace_url: ""
      catalog: staging
      schema: {{ project_name }}_staging

  prod:
    mode: production
    variables:
      workspace_url: ""
      catalog: main
      schema: {{ project_name }}
{% if headless_auth == "service_principal" %}
    run_as:
      service_principal_name: ${var.service_principal_id}
{% endif %}
