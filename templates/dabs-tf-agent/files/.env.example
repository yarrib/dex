# Databricks workspace (local dev / CLI).
DATABRICKS_HOST=
DATABRICKS_TOKEN=

{% if llm_provider == "anthropic" -%}
# Direct Anthropic access (when llm_provider = anthropic).
ANTHROPIC_API_KEY=
{%- else -%}
# Databricks Foundation Model serving endpoint (when llm_provider = databricks).
LLM_ENDPOINT=databricks-claude-opus-4
{%- endif %}

{% if git_host == "github" -%}
# Git host: GitHub. A classic/fine-grained PAT with `repo` scope, OR leave blank
# locally to fall back to the `gh` CLI / OBO token at runtime.
GITHUB_TOKEN=
{%- else -%}
# Git host: Azure DevOps. A PAT with Code (Read & Write) + Pull Request scope, OR
# leave blank locally to fall back to `az` CLI / OBO token at runtime.
AZURE_DEVOPS_TOKEN=
{%- endif %}
