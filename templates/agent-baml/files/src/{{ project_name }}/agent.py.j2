"""{{ project_name }} — {{ description }}"""

import logging

import mlflow

from baml_client import b
from baml_client.types import AgentOutput

logger = logging.getLogger(__name__)


def run(input_data: str | None = None) -> str:
    """Run the agent.

    Args:
        input_data: Input to the agent. None for scheduled/event-triggered agents.

    Returns:
        Agent output or status message.
    """
    mlflow.set_experiment("{{ project_name }}")

    logger.info("agent_start", extra={"input": input_data})

    result: AgentOutput = b.RunAgent(input=input_data or "")

    logger.info("agent_complete", extra={"result": result.result})
    return result.result


def main() -> None:
    """CLI entry point for local development."""
    import json
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    result = run()
    print(json.dumps({"result": result}, indent=2))


if __name__ == "__main__":
    main()
