{%- if database == 'postgres' %}
# DBOS system database (matches docker-compose.yml).
DBOS_DATABASE_URL=postgresql://postgres:dbos@localhost:5432/{{ project_name }}
{%- else %}
# Lakebase (Databricks Postgres) — the DBOS system database.
LAKEBASE_HOST=
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_USER=
DATABRICKS_HOST=
# Auth: DATABRICKS_TOKEN, or an OAuth profile / service principal (see databricks-sdk).
DATABRICKS_TOKEN=
{%- endif %}

# Model client
{%- if llm_sdk == 'openai' %}
OPENAI_API_KEY=
# For Databricks model serving, point the OpenAI client at your workspace:
# OPENAI_BASE_URL=https://<workspace>/serving-endpoints
LLM_MODEL=gpt-4o-mini
{%- else %}
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
{%- endif %}

# Run behaviour
MAX_CONCURRENT_RUNS={{ max_concurrent_runs }}
MAX_RUNS_PER_MINUTE=60
MAX_TURNS=10
APPROVAL_TIMEOUT_SECONDS=86400
# Bump when you change a workflow's step order (see AGENTS.md).
APP_VERSION=1
