"""Shared fixtures. Tests run on a throwaway SQLite system database by default; set
TEST_DATABASE_URL to run the same suite against Postgres."""

from __future__ import annotations

import os
import subprocess
import sys
import time
import uuid
from collections.abc import Callable, Iterator
from pathlib import Path
from typing import Any

import pytest

ROOT = Path(__file__).resolve().parent.parent


@pytest.fixture
def env(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> dict[str, str]:
    """Isolated environment for one test; also inherited by crash-worker subprocesses."""
    url = os.environ.get("TEST_DATABASE_URL") or f"sqlite:///{tmp_path / 'dbos.sqlite'}"
    values = {
        "DBOS_DATABASE_URL": url,
        "EFFECTS_DB_PATH": str(tmp_path / "effects.sqlite"),
        "LLM_LOG": str(tmp_path / "llm_calls.jsonl"),
        "CRASH_MARKER": str(tmp_path / "crashed"),
        "AGENT_TRACING": "0",
        "QUEUE_POLL_SECONDS": "0.1",
    }
    for key, value in values.items():
        monkeypatch.setenv(key, value)
    return values


@pytest.fixture
def launch_runtime(
    env: dict[str, str], monkeypatch: pytest.MonkeyPatch
) -> Iterator[Callable[..., None]]:
    """`launch_runtime(**settings)` starts DBOS in-process; torn down after the test."""
    from {{ project_name }} import runtime
    from {{ project_name }}.steps.llm import set_backend

    def launch(**settings: str) -> None:
        for key, value in settings.items():
            monkeypatch.setenv(key, value)
        runtime.launch()

    yield launch
    set_backend(None)
    runtime.shutdown()


def wait_for(predicate: Callable[[], Any], timeout: float = 30.0, interval: float = 0.05) -> Any:
    """Poll until `predicate()` is truthy; return its value or fail the test on timeout.

    Errors while polling are tolerated (e.g. the database does not exist yet because a
    worker subprocess is still starting) and re-raised if the deadline passes.
    """
    deadline = time.monotonic() + timeout
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        try:
            value = predicate()
            if value:
                return value
        except Exception as exc:
            last_error = exc
        time.sleep(interval)
    raise AssertionError(f"condition not met within {timeout}s (last error: {last_error!r})")


def new_run_id() -> str:
    return f"test-{uuid.uuid4()}"


def run_worker(scenario: str, run_id: str) -> subprocess.Popen[bytes]:
    return subprocess.Popen(
        [sys.executable, "-m", "tests._crash_worker", scenario, run_id],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
