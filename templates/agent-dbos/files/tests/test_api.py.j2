def test_run_completes_and_status_reports_result(client):
    set_backend(FakeLLM([tool_call("echo", text="hi"), Completion(text="echoed")]))
    run_id = start_run(client)

    body = wait_success(client, run_id)

    assert body["result"]["output"] == "echoed"


def test_index_page_is_served_and_renders_untrusted_text_safely(client):
    response = client.get("/")

    assert response.status_code == 200
    assert "<title>{{ project_name }}</title>" in response.text
    # Tool arguments come from the model: the page must never feed them to innerHTML.
    assert "innerHTML" not in response.text


def test_unknown_run_is_404(client):
    assert client.get("/runs/does-not-exist").status_code == 404


def test_sse_reconnect_with_last_event_id_replays_nothing_twice(client):
    set_backend(FakeLLM([tool_call("echo", text="hi"), Completion(text="echoed")]))
    run_id = start_run(client)
    wait_for(lambda: client.get(f"/runs/{run_id}").json()["status"] == "SUCCESS")

    full = stream_events(client, run_id)
    assert [e["event"] for e in full] == ["started", "turn", "tool_result", "turn", "finished"]
    assert [int(e["id"]) for e in full] == [0, 1, 2, 3, 4]

    # Drop after two events, reconnect from the last id we saw: the rest arrive once, in order.
    first = stream_events(client, run_id, stop_after=2)
    rest = stream_events(client, run_id, last_event_id=first[-1]["id"])
    assert [e["id"] for e in first + rest] == [e["id"] for e in full]
    assert first + rest == full
