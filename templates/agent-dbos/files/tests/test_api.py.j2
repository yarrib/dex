def test_inbox_approve_over_http(client):
    set_backend(FakeLLM([tool_call("record_note", text="hello"), Completion(text="done")]))
    run_id = start_run(client, "record a note")

    item = wait_for(lambda: inbox_item(client, run_id))
    assert item["call"]["name"] == "record_note"

    assert client.post(f"/runs/{run_id}/approve", json={"reason": "ok"}).status_code == 200
    body = wait_success(client, run_id)
    assert body["result"]["status"] == "completed"


def test_reject_over_http(client):
    set_backend(FakeLLM([tool_call("record_note", text="hello"), Completion(text="done")]))
    run_id = start_run(client, "record a note")
    wait_for(lambda: inbox_item(client, run_id))

    client.post(f"/runs/{run_id}/reject", json={"reason": "no"})
    body = wait_success(client, run_id)
    assert body["result"]["status"] == "rejected"
