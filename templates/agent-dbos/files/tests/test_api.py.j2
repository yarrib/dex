def parse_sse(lines: Iterator[str]) -> list[dict[str, Any]]:
    events, current = [], {}
    for line in lines:
        if line.strip() == "":
            if current:
                events.append(current)
                current = {}
        elif ":" in line and not line.startswith(":"):
            key, _, value = line.partition(":")
            current[key] = value.strip()
    if current:
        events.append(current)
    return events


def stream_events(
    client: TestClient,
    run_id: str,
    last_event_id: str | None = None,
    stop_after: int | None = None,
) -> list[dict[str, Any]]:
    headers = {"Last-Event-ID": last_event_id} if last_event_id is not None else {}
    events: list[dict[str, Any]] = []
    with client.stream("GET", f"/runs/{run_id}/events", headers=headers) as response:
        assert response.status_code == 200
        for event in parse_sse(response.iter_lines()):
            events.append(event)
            if stop_after is not None and len(events) >= stop_after:
                break  # simulate the client dropping mid-stream
    return events


def start_run(client: TestClient, task: str = "echo hi") -> str:
    response = client.post("/runs", json={"task": task})
    assert response.status_code == 202
    return response.json()["run_id"]


def wait_success(client: TestClient, run_id: str) -> dict[str, Any]:
    def done() -> dict[str, Any] | None:
        body = client.get(f"/runs/{run_id}").json()
        return body if body["status"] == "SUCCESS" else None

    return wait_for(done)
