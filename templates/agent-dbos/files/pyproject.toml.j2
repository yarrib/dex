[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
    # Pinned to a minor: replay semantics must not change under you (see AGENTS.md).
    "dbos~=3.4",
    "pydantic>=2.6",
    "mlflow>=2.14",
{%- if llm_sdk == 'openai' %}
    "openai>=1.40",
{%- else %}
    "anthropic>=0.40",
{%- endif %}
{%- if include_api %}
    "fastapi>=0.110",
    "uvicorn>=0.29",
    "sse-starlette>=2.1",
{%- endif %}
{%- if database == 'lakebase' or deploy_target == 'databricks_app' %}
    "databricks-sdk>=0.30",
{%- endif %}
]

[project.scripts]
{{ project_name }} = "{{ project_name }}.cli:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_name }}"]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.4",
{%- if include_api %}
    "httpx>=0.27",
{%- endif %}
]

[tool.uv]
python-version = "{{ python_version }}"

[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 99

[tool.ruff.lint]
select = ["E", "F", "I", "UP"]

[tool.ruff.lint.isort]
# Keep `tests` in its own section so import order doesn't depend on the project's name.
known-local-folder = ["tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
