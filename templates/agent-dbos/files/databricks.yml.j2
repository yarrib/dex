bundle:
  name: {{ project_name }}

include:
  - resources/*.yml

variables:
  workspace_url:
    description: Databricks workspace URL
{%- if database == 'lakebase' %}
  lakebase_instance:
    description: Name of the Lakebase database instance used as the DBOS system database
{%- endif %}

workspace:
  host: ${var.workspace_url}

targets:
  dev:
    default: true
    mode: development

  prod:
    mode: production
