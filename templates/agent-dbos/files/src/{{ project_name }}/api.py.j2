"""FastAPI service: start runs, follow them over SSE{% if include_hitl %}, approve or reject them{% endif %}.

Endpoints
  POST /runs                    {"task": "..."}      -> {"run_id": "..."}  (enqueued)
  GET  /runs/{id}                                     -> status, output{% if include_hitl %}, pending approval{% endif %}

  GET  /runs/{id}/events        SSE of durable progress events; reconnect with
                                `Last-Event-ID: <offset>` (or ?after=<offset>) and receive
                                only events after it, each exactly once, in order.
  GET  /runs/{id}/tokens        SSE of live model tokens (in-memory, NOT resumable)
{%- if include_hitl %}
  GET  /inbox                                         -> runs waiting for approval
  POST /runs/{id}/approve|reject  {"reason": "..."}
{%- endif %}
"""

from __future__ import annotations

import asyncio
import json
import queue
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from pathlib import Path
from typing import Any

from dbos import DBOS
from fastapi import FastAPI, Header, HTTPException, Query
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
from sse_starlette.sse import EventSourceResponse

from {{ project_name }} import runtime
{%- if include_hitl %}
from {{ project_name }}.steps.approval import pending_approval, submit_decision
{%- endif %}
from {{ project_name }}.streaming import aread_events, tokens
from {{ project_name }}.workflows.agent_run import agent_run
from {{ project_name }}.workflows.queue import enqueue_run

PAGE = Path(__file__).parent / "static" / "index.html"
TERMINAL = {"SUCCESS", "ERROR", "CANCELLED", "MAX_RECOVERY_ATTEMPTS_EXCEEDED"}


@asynccontextmanager
async def lifespan(_: FastAPI) -> AsyncIterator[None]:
    launched = await asyncio.to_thread(runtime.launch)
    try:
        yield
    finally:
        if launched:  # tests may own the runtime; only tear down what we started
            await asyncio.to_thread(runtime.shutdown)


app = FastAPI(title="{{ project_name }}", lifespan=lifespan)


class RunRequest(BaseModel):
    task: str


class Decision(BaseModel):
    reason: str = ""


def _status(run_id: str) -> dict[str, Any]:
    handle = _handle(run_id)
    status = handle.get_status()
    body: dict[str, Any] = {"run_id": run_id, "status": status.status}
    if status.status == "SUCCESS":
        body["result"] = status.output
    elif status.status == "ERROR":
        body["error"] = str(status.error)
{%- if include_hitl %}
    elif status.status == "PENDING":
        body["pending_approval"] = pending_approval(run_id)
{%- endif %}
    return body


def _handle(run_id: str) -> Any:
    try:
        return DBOS.retrieve_workflow(run_id)
    except Exception as exc:  # DBOS raises if the id is unknown
        raise HTTPException(404, f"no such run: {run_id}") from exc


@app.post("/runs", status_code=202)
async def create_run(req: RunRequest) -> dict[str, str]:
    return {"run_id": await asyncio.to_thread(enqueue_run, req.task)}


@app.get("/runs/{run_id}")
async def get_run(run_id: str) -> dict[str, Any]:
    return await asyncio.to_thread(_status, run_id)


@app.get("/runs/{run_id}/events")
async def run_events(
    run_id: str,
    last_event_id: str | None = Header(default=None),
    after: int | None = Query(default=None),
) -> EventSourceResponse:
    await asyncio.to_thread(_handle, run_id)
    start = after if after is not None else (int(last_event_id) if last_event_id else -1)

    async def generate() -> AsyncIterator[dict[str, str]]:
        async for offset, event in aread_events(run_id, after=start):
            yield {"id": str(offset), "event": event["kind"], "data": json.dumps(event["data"])}

    return EventSourceResponse(generate())


@app.get("/runs/{run_id}/tokens")
async def run_tokens(run_id: str) -> EventSourceResponse:
    """Live model tokens from the process executing the run. Not durable or resumable."""
    await asyncio.to_thread(_handle, run_id)

    async def generate() -> AsyncIterator[dict[str, str]]:
        q = tokens.subscribe(run_id)
        try:
            while True:
                try:
                    token = await asyncio.to_thread(q.get, True, 1.0)
                except queue.Empty:
                    status = await asyncio.to_thread(lambda: _handle(run_id).get_status().status)
                    if status in TERMINAL:
                        return
                    continue
                yield {"event": "token", "data": json.dumps(token)}
        finally:
            tokens.unsubscribe(run_id, q)

    return EventSourceResponse(generate())
{%- if include_hitl %}


@app.get("/inbox")
async def inbox() -> list[dict[str, Any]]:
    def collect() -> list[dict[str, Any]]:
        waiting = []
        runs = DBOS.list_workflows(
            name=agent_run.__qualname__, status="PENDING", load_input=False, load_output=False
        )
        for wf in runs:
            pending = pending_approval(wf.workflow_id)
            if pending:
                waiting.append({"run_id": wf.workflow_id, **pending})
        return waiting

    return await asyncio.to_thread(collect)


@app.post("/runs/{run_id}/approve")
async def approve(run_id: str, body: Decision | None = None) -> dict[str, str]:
    await asyncio.to_thread(_handle, run_id)
    await asyncio.to_thread(submit_decision, run_id, True, body.reason if body else "")
    return {"run_id": run_id, "decision": "approved"}


@app.post("/runs/{run_id}/reject")
async def reject(run_id: str, body: Decision | None = None) -> dict[str, str]:
    await asyncio.to_thread(_handle, run_id)
    await asyncio.to_thread(submit_decision, run_id, False, body.reason if body else "")
    return {"run_id": run_id, "decision": "rejected"}
{%- endif %}


@app.get("/", response_class=HTMLResponse)
async def index() -> str:
    return PAGE.read_text()
