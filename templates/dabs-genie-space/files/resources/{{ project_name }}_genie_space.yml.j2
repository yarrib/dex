resources:
  genie_spaces:
    {{ project_name }}_space:
      display_name: "${bundle.target} — {{ project_name | replace('_', ' ') | title }}"
      warehouse_id: {% if warehouse_id %}"{{ warehouse_id }}"{% else %}${var.warehouse_id}{% endif %}

      description: "AI-powered data assistant for {{ project_name | replace('_', ' ') }}"

      tables:
        - catalog_name: ${var.catalog}
          schema_name: ${var.schema}
          # Add table names here
          # table_name: my_table

{% if include_sample_instructions %}
      instructions_file_path: ../src/{{ project_name }}/instructions/curated_questions.md
{% endif %}
