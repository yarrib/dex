[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Databricks Asset Bundle project ({{ profile }})"
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author }}" }]
dependencies = [
    "databricks-sdk",
{% if include_experiment or include_agent %}    "mlflow",
{% endif %}{% if include_agent %}    "databricks-agents",
{% endif %}{% if shared_code_source in ["workspace", "path"] %}    "shared",
{% endif %}]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.4",
    "ty>=0.0.1a1",
    "databricks-connect",
]

{% if shared_code_source == "workspace" %}
# Monorepo coupling: `shared` is resolved from the surrounding uv workspace.
[tool.uv.sources]
shared = { workspace = true }
{% elif shared_code_source == "path" %}
[tool.uv.sources]
shared = { path = "../shared", editable = true }
{% endif %}
[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 99

[tool.ruff.lint]
select = ["E", "F", "I", "UP"]

[tool.ty.environment]
root = ["./src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
