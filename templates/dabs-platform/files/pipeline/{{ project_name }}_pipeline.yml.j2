resources:
  pipelines:
    {{ project_name }}_pipeline:
      name: ${bundle.target}-{{ project_name }}-pipeline
      catalog: ${var.catalog}
      schema: ${var.schema}
      serverless: {% if use_serverless %}true{% else %}false{% endif %}

      libraries:
        - glob:
            include: src/{{ project_name }}/**

      configuration:
        bundle.target: ${bundle.target}
