name: CI

on:
  pull_request:
  push:
    branches: [main]

# Delegates to the org's central reusable workflow, which runs
# uv sync / ruff / ty / pytest / databricks bundle validate.
jobs:
  ci:
    uses: {{ central_ci_ref }}
    secrets: inherit
    with:
      python-version: "{{ python_version }}"
{% if include_react %}      build-frontend: true
      frontend-dir: frontend
{% endif %}
