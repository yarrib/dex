resources:
  jobs:
    {{ project_name }}_batch_infer:
      name: ${bundle.target}-{{ project_name }}-batch-infer

      schedule:
        quartz_cron_expression: "0 0 6 * * ?"
        timezone_id: UTC

      tasks:
        - task_key: batch_infer
          python_wheel_task:
            package_name: {{ project_name }}
            entry_point: main
            parameters:
              - "--catalog"
              - "${var.catalog}"
              - "--schema"
              - "${var.schema}"
{% if use_serverless %}
          environment_key: default

      environments:
        - environment_key: default
          spec:
            client: "1"
{% else %}
          new_cluster:
            spark_version: 15.4.x-scala2.12
            node_type_id: Standard_DS3_v2
            num_workers: 1
            data_security_mode: SINGLE_USER
{% endif %}
