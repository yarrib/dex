#!/usr/bin/env bash
# Generated by `dex agent-env init` from dex.agent-env.toml — do not edit by hand.
set -uo pipefail

OVERALL_EXIT=0
FAILED_STEP=""
ALWAYS_STEPS_RAN=0

run_always_steps() {
  if [ "$ALWAYS_STEPS_RAN" -eq 1 ]; then return; fi
  ALWAYS_STEPS_RAN=1
{% for step in steps if step.always %}
  echo "==> {{ step.name }} (always)"
  ( {{ step.run }} )
  step_code=$?
  if [ "$step_code" -ne 0 ]; then
    echo "==> {{ step.name }} (always): FAILED (exit ${step_code})" >&2
  else
    echo "==> {{ step.name }} (always): OK"
  fi
{% endfor %}
}
trap run_always_steps EXIT

{% for step in steps if not step.always %}
if [ "$OVERALL_EXIT" -eq 0 ]; then
  echo "==> {{ step.name }}"
  ( {{ step.run }} )
  step_code=$?
  if [ "$step_code" -ne 0 ]; then
    OVERALL_EXIT=$step_code
    FAILED_STEP="{{ step.name }}"
    echo "==> {{ step.name }}: FAILED (exit ${step_code})" >&2
  else
    echo "==> {{ step.name }}: OK"
  fi
fi
{% endfor %}

if [ -n "$FAILED_STEP" ]; then
  echo "verify failed at step: ${FAILED_STEP}" >&2
fi
exit "$OVERALL_EXIT"
