# Generated by `dex agent-env init` from dex.agent-env.toml — do not edit by hand.
#
# Requires repo/org secrets named {{ client_id_env }} and {{ client_secret_env }}
# (the names configured in dex.agent-env.toml's [auth.service_principal_env]).
name: Agent Env

on:
{% if cron %}
  schedule:
    - cron: "{{ cron }}"
{% endif %}
  workflow_dispatch:
  pull_request:

permissions:
  contents: read

jobs:
  rebuild-base-image:
    name: Rebuild devcontainer base image
    if: github.event_name == 'workflow_dispatch'{% if cron %} || github.event_name == 'schedule'{% endif %}

    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build devcontainer image
        run: docker build -f .devcontainer/Dockerfile -t agent-env:refresh .

  verify:
    name: Run agent-env verify steps
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build and run verify inside the devcontainer
        uses: devcontainers/ci@v0.3
        with:
          runCmd: bash .devcontainer/verify.sh
        env:
          {{ client_id_env }}: {{ "${{" }} secrets.{{ client_id_env }} {{ "}}" }}
          {{ client_secret_env }}: {{ "${{" }} secrets.{{ client_secret_env }} {{ "}}" }}
