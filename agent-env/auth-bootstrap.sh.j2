#!/usr/bin/env bash
# Generated by `dex agent-env init` from dex.agent-env.toml — do not edit by hand.
set -euo pipefail

CLIENT_ID_VAR="{{ client_id_env }}"
CLIENT_SECRET_VAR="{{ client_secret_env }}"
WORKSPACE_HOST="{{ workspace_host }}"
PROFILE_NAME="{{ profile_name }}"

if [ -z "${!CLIENT_ID_VAR:-}" ]; then
  echo "error: environment variable ${CLIENT_ID_VAR} is not set (required by dex.agent-env.toml: auth.service_principal_env.client_id)" >&2
  exit 1
fi
if [ -z "${!CLIENT_SECRET_VAR:-}" ]; then
  echo "error: environment variable ${CLIENT_SECRET_VAR} is not set (required by dex.agent-env.toml: auth.service_principal_env.client_secret)" >&2
  exit 1
fi

CLIENT_ID="${!CLIENT_ID_VAR}"
CLIENT_SECRET="${!CLIENT_SECRET_VAR}"

echo "Validating Databricks OAuth M2M credentials against ${WORKSPACE_HOST}..."
if ! RESPONSE="$(curl -sS -f -u "${CLIENT_ID}:${CLIENT_SECRET}" \
      "${WORKSPACE_HOST}/oidc/v1/token" \
      -d grant_type=client_credentials \
      -d scope=all-apis)"; then
  echo "error: OAuth client-credentials token exchange failed against ${WORKSPACE_HOST}/oidc/v1/token — check the workspace host and service principal credentials" >&2
  exit 1
fi
case "$RESPONSE" in
  *access_token*) ;;
  *) echo "error: token exchange succeeded but no access_token in response: ${RESPONSE}" >&2; exit 1 ;;
esac

CFG="${HOME}/.databrickscfg"
touch "$CFG"

# Idempotent: strip any prior [PROFILE_NAME] section before appending.
awk -v section="[${PROFILE_NAME}]" '
  $0 == section { skip=1; next }
  /^\[/ { skip=0 }
  !skip { print }
' "$CFG" > "${CFG}.tmp" && mv "${CFG}.tmp" "$CFG"

cat >> "$CFG" <<PROFILE
[${PROFILE_NAME}]
host = ${WORKSPACE_HOST}
client_id = ${CLIENT_ID}
client_secret = ${CLIENT_SECRET}
auth_type = oauth-m2m
PROFILE
chmod 600 "$CFG"

echo "Wrote Databricks CLI profile '${PROFILE_NAME}' to ${CFG} (catalog={{ catalog }}, schema={{ schema }})"
